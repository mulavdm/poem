name: POEM CI

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  go:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true
      - run: test -z "$(gofmt -l .)"
        shell: bash
      - run: go test ./...
      - run: go test -race ./...
      - run: go vet ./...
      - run: go mod verify
      - uses: msys2/setup-msys2@v2
        with:
          update: false
          install: mingw-w64-ucrt-x86_64-gcc
      - uses: ilammy/msvc-dev-cmd@v1
      - name: Build and verify Windows application DLLs
        shell: pwsh
        run: |
          $env:CGO_ENABLED = "1"
          $env:CC = "C:\msys64\ucrt64\bin\gcc.exe"
          go build -buildmode=c-shared -o gallery_poem_app.dll ./cmd/gallery
          go build -buildmode=c-shared -o engine_poem_app.dll ./cmd/engine
          $exports = (& dumpbin /exports gallery_poem_app.dll) -join "`n"
          foreach ($name in @("PoemWindowsABIVersion", "PoemWindowsMetadata", "PoemWindowsStart", "PoemHostRead", "PoemHostWrite", "PoemWindowsStop")) {
            if ($exports -notmatch $name) { throw "missing DLL export $name" }
          }
      - run: git diff --check

  windows-host:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: ilammy/msvc-dev-cmd@v1
      - uses: lukka/get-cmake@latest
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true
      - uses: msys2/setup-msys2@v2
        with:
          update: false
          install: mingw-w64-ucrt-x86_64-gcc
      - run: cmake -S cpp_sidecar -B cpp_sidecar/build -A x64
      - run: cmake --build cpp_sidecar/build --config Release --target poem_windows_host -- /m:1
      - run: cmake --build cpp_sidecar/build --config Release --target poem_windows_host_contract_test -- /m:1
      - run: ctest --test-dir cpp_sidecar/build -C Release --output-on-failure
      - name: Build portable bundle and unsigned MSIX
        shell: pwsh
        run: |
          ./windows_host/build.ps1 -ProjectDirectory . -GoPackage ./cmd/gallery -Identity POEM.Gallery -DisplayName "POEM Gallery" -Version 0.0.0.0 -OutputDirectory artifacts
