name: POEM Release

on:
  push:
    tags: ["v*.*.*"]

permissions:
  contents: write

jobs:
  release:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true
      - uses: ilammy/msvc-dev-cmd@v1
      - uses: lukka/get-cmake@latest
      - uses: msys2/setup-msys2@v2
        with:
          update: false
          install: mingw-w64-ucrt-x86_64-gcc
      - run: go test ./...
      - run: go test -race ./...
      - run: go vet ./...
      - run: go mod verify
      - name: Build portable ZIP and unsigned MSIX
        shell: pwsh
        env:
          POEM_WINDOWS_CERT_PATH: ${{ secrets.POEM_WINDOWS_CERT_PATH }}
          POEM_WINDOWS_CERT_THUMBPRINT: ${{ secrets.POEM_WINDOWS_CERT_THUMBPRINT }}
          POEM_WINDOWS_CERT_PASSWORD: ${{ secrets.POEM_WINDOWS_CERT_PASSWORD }}
        run: |
          $semver = $env:GITHUB_REF_NAME.TrimStart('v')
          $arguments = @{
            ProjectDirectory = "."
            GoPackage = "./cmd/gallery"
            Identity = "POEM.Gallery"
            DisplayName = "POEM Gallery"
            Version = "$semver.0"
            OutputDirectory = "release"
          }
          if ($env:POEM_WINDOWS_CERT_PATH) { $arguments.CertificatePath = $env:POEM_WINDOWS_CERT_PATH }
          elseif ($env:POEM_WINDOWS_CERT_THUMBPRINT) { $arguments.CertificateThumbprint = $env:POEM_WINDOWS_CERT_THUMBPRINT }
          ./windows_host/build.ps1 @arguments
      - run: gh release create "$env:GITHUB_REF_NAME" --verify-tag --generate-notes
        env:
          GH_TOKEN: ${{ github.token }}
      - run: gh release upload "$env:GITHUB_REF_NAME" release/*.zip release/*.msix --clobber
        env:
          GH_TOKEN: ${{ github.token }}
